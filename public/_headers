# Cloudflare response headers — parsed for Workers static assets and Pages
# deployments alike. (`#` is the only comment syntax this format supports.)
#
# COOP/COEP enable cross-origin isolation → SharedArrayBuffer → the
# multithreaded WebAssembly engines. Everything served is same-origin, or
# carries Cross-Origin-Resource-Policy: cross-origin (the pinned jsDelivr
# engine binaries), so require-corp is safe.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/wasm/*
  Cache-Control: public, max-age=31536000, immutable

/ffmpeg/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/*.html
  Cache-Control: public, max-age=0, must-revalidate
