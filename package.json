{
  "name": "omnimediahub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-vendor-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-vendor-assets.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "client-zip": "^2.5.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "idb-keyval": "^6.3.0",
    "piexifjs": "^1.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "wasm-vips": "^0.0.19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/piexifjs": "^1.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
